  nodes:
  - name: df
    transformer:
      class_name: DataSource
      module_name: damast.core.processing_graph
      name_mappings:
        df: {}
      parameters: {}
      requires:
        distribution: damast
        version: 0.3.8
    uuid: 1ea7614c-fcc0-4c5a-a392-d797de47a78b
  - name: drop_missing_timestamp
    transformer:
      class_name: DropMissingOrNan
      module_name: damast.data_handling.transformers.filters
      name_mappings:
        df:
          x: timestamp
      parameters: {}
      requires: &id001
        distribution: damast
        version: 0.3.8
    uuid: d2187c72-18d5-4b19-8e37-07ef0f66983c
  - name: filter_ship_types
    transformer:
      class_name: FilterWithin
      module_name: damast.data_handling.transformers.filters
      name_mappings:
        df:
          x: ship_type
      parameters:
        within_values:
