          group: mmsi
          out: delta_distance
          sort: timestamp
          x: latitude
          y: longitude
      parameters:
        x_shift: true
        y_shift: true
      requires: &id002
        distribution: damast
        version: 0.3.8
    uuid: 20a94897-8aa2-4b4c-9aac-337911d3b661
